{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express + Prisma CRUD Backend for Neon PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "./node_modules/.bin/nodemon src/server.js",
